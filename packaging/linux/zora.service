# systemd user unit: install with packaging/linux/install.sh, then `systemctl --user enable --now zora`.
[Unit]
Description=Zora voice command service
After=pipewire.service

[Service]
ExecStart=%h/.local/bin/zorad run
Restart=on-failure
RestartSec=5
# 78: the config is invalid. Restarting won't help; `zorad status` says what to fix.
RestartPreventExitStatus=78
# The whole cgroup (core, guards, harness jobs) stops with the service.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
